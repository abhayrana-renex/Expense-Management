# =========================================
# Expense Management Portal - backend environment
# Copy to backend/.env (UTF-8) and fill in real values. Never commit .env.
# =========================================

# ---------- App ----------
APP_NAME=Expense Management Portal
APP_ENV=development
API_V1_PREFIX=/api

# ---------- Database ----------
# Either a full URL (URL-encode special characters in the password: @ -> %40) ...
# The portal shares FAR's database (company_db) so both apps use the same master tables.
DATABASE_URL=postgresql+psycopg2://expense_admin:CHANGE_ME@localhost:5433/company_db
# ... or the parts below (used only when DATABASE_URL is empty; encoded automatically).
POSTGRES_USER=expense_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=company_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
# Portal's own tables (tests always use "test_suite")
DB_SCHEMA=expense
# FAR's shared master tables: departments, branches, partners, assignees (tests: "test_core")
MASTER_SCHEMA=core

# ---------- Auth ----------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"   (min 32 chars)
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=12
IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=20
PASSWORD_MIN_LENGTH=10
PASSWORD_HISTORY_COUNT=5
# 0 disables password expiry
PASSWORD_EXPIRY_DAYS=90

# ---------- Files ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
SIGNED_URL_TTL_SECONDS=60

# ---------- HTTP ----------
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# ---------- Feature flags ----------
FEATURE_TOTP_2FA=false
ENFORCE_GST_RULES=false
FEATURE_BILL_READER=true
# band = ONE approver chosen by amount band; chain = L1 -> L2 -> L3 in turn
APPROVAL_ROUTING=band
# Bulk approve only for claims at or below this amount (and with no warnings)
BULK_APPROVE_MAX_AMOUNT=50000.00

# ---------- Bill reader (QR + PDF text + OCR) ----------
# Our own GSTINs (comma-separated) so the reader knows which GSTIN on a bill is the buyer
COMPANY_GSTINS=
# Our company name(s) (comma-separated) so they are never mistaken for the vendor
COMPANY_NAMES=
BILL_READER_MAX_PAGES=4

# ---------- Seed (development only) ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_EMAIL=admin@yourcompany.com
# Password for demo users created by `python -m app.cli seed-demo`
SEED_DEMO_PASSWORD=CHANGE_ME
